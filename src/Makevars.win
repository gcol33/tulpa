CXX_STD = CXX17
PKG_CPPFLAGS = -I../inst/include

# -Wa,-mbig-obj selects the bigobj COFF variant, whose section count is bounded
# by 2^31 instead of the 32767 a plain COFF object holds. Windows is the only
# platform with that ceiling, and the inference kernels reach it: gcc emits one
# comdat section per template instantiation and merges none of them at -O0, so
# nested_laplace_joint_multi.cpp alone assembles 50241 sections and aghq_re.cpp
# 36959, and the assembler stops with "file too big". Any build that does not
# optimize hits this -- pkgbuild::compile_dll(debug = TRUE) is the default and is
# what devtools::load_all() goes through. At R's own -O2 the largest of the 10
# unity objects is 2200 sections, so an optimizing
# build does not need the flag and does not get it: R CMD check reports
# -Wa,-mbig-obj as a non-portable flag whenever a compile command carries it.
# The test is expanded when a compile rule runs, after Makeconf and any user
# Makevars have been read, and R CMD SHLIB sets CXXFLAGS to the CXX17FLAGS the
# rule compiles with, so it reads the flags actually in use.
# The last recognized optimization flag determines whether bigobj is enabled.
comma := ,
BIGOBJ_FLAG = $(if $(filter -O2 -O3 -Os -Ofast,$(lastword $(filter -O0 -O1 -O2 -O3 -Os -Ofast -Og,$(CXXFLAGS)))),,-Wa$(comma)-mbig-obj)

# gcc reports every RcppEigen SSE packet type it instantiates under
# -Wignored-attributes, about 7400 warnings over the 11 unity objects, and prints
# each with its source line, a caret line and the full template instantiation
# chain, and R CMD check scans the install log line by line for warnings.
# Dropping the caret and keeping one instantiation context leaves every warning
# and its location in the log, at 5.4 MB. The flags
# are gcc spellings, so a clang toolchain (Rtools on aarch64) does not get them.
DIAG_FLAGS = $(if $(findstring clang,$(CXX)),,-fno-diagnostics-show-caret -ftemplate-backtrace-limit=1)
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) $(BIGOBJ_FLAG) $(DIAG_FLAGS)

PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

# The package compiles as a unity build: each src/unity_<group>.cpp includes
# the sources of one group, so a template the group shares is instantiated once
# and gcc reports each of its -Wignored-attributes warnings once per group
# rather than once per source file, in the install log R CMD check scans line by
# line. OBJECTS names only the unity files, and each
# one lists its members as prerequisites so editing a member rebuilds its group.
# tools/unity.R writes the block below from the unity files' member lists.
# unity-build: begin (written by tools/unity.R)
OBJECTS = \
  unity_core.o \
  unity_exports.o \
  unity_glmm.o \
  unity_hmc.o \
  unity_laplace.o \
  unity_nl.o \
  unity_nl_joint.o \
  unity_pg.o \
  unity_samplers.o \
  unity_spatial.o
all: $(SHLIB)
