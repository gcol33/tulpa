CXX_STD = CXX17
PKG_CPPFLAGS = -I../inst/include

# -Wa,-mbig-obj selects the bigobj COFF variant, whose section count is bounded
# by 2^31 instead of the 32767 a plain COFF object holds. Windows is the only
# platform with that ceiling, and the inference kernels reach it: gcc emits one
# comdat section per template instantiation and merges none of them at -O0, so
# nested_laplace_joint_multi.cpp assembles 50241 sections and aghq_re.cpp 36959,
# and the assembler stops with "file too big". Any build that does not optimize
# hits this -- pkgbuild::compile_dll(debug = TRUE) is the default and is what
# devtools::load_all() goes through. At R's own -O2 the largest of the 109
# translation units is 2221 sections, so at the installed build this only
# changes the object format.
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -Wa,-mbig-obj

PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
